{
	"name": "@instance/streaming",
	"version": "0.1.0",
	"description": "Object-centric process discovery on event streams with bounded buffers and eviction heuristics",
	"author": "Menne, Sebastian",
	"private": true,
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"generate:api": "uv run ocelescope-backend openapi --module streaming",
